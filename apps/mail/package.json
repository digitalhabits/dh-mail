{
  "name": "digital-habits-mail",
  "version": "0.10.0",
  "private": true,
  "packageManager": "pnpm@9.14.4",
  "description": "Digital Habits: Mail — desktop and phone mail app (Tauri + Vite).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ulyngs/digital-habits-planner.git",
    "directory": "apps/mail"
  },
  "homepage": "https://github.com/ulyngs/digital-habits-planner#readme",
  "scripts": {
    "test": "node tests/run.mjs",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:dev:demo": "VITE_MAIL_DEMO=1 tauri dev",
    "ui:dev:demo": "VITE_MAIL_DEMO=1 vite",
    "app:dev:internal": "MAIL_FLAVOR=internal MAIL_DEV_PORT=3473 tauri dev",
    "app:build": "bash scripts/build-standalone.sh",
    "app:build:internal": "MAIL_FLAVOR=internal bash scripts/build-standalone.sh",
    "app:build:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build-win.ps1",
    "app:build:win:unsigned": "powershell -ExecutionPolicy Bypass -File ./scripts/build-win.ps1 -Unsigned",
    "app:build:win-store": "powershell -ExecutionPolicy Bypass -File ./scripts/build-win-store.ps1",
    "ui:dev": "vite",
    "ui:dev:phone": "VITE_MAIL_DEMO=1 VITE_MAIL_MOBILE=1 vite",
    "ui:build": "vite build",
    "app:ios:init": "tauri ios init",
    "app:ios:dev": "tauri ios dev --host",
    "app:ios:build": "tauri ios build",
    "app:android:init": "tauri android init",
    "app:android:dev": "tauri android dev --host",
    "app:android:build": "tauri android build",
    "app:mobile:icons": "tauri icon src-tauri/dh-mail-icon-source.png -o src-tauri/icons"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/rich-text": "0.48.0",
    "@lexical/selection": "0.48.0",
    "@mdxeditor/editor": "^4.1.1",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lexical": "0.48.0",
    "lucide-react": "^1.27.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-quill-new": "^3.7.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.12.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^6.0.7"
  }
}
