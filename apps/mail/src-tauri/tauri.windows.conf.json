{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "title": "Digital Habits: Mail",
        "decorations": false,
        "dragDropEnabled": false,
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#faf8f5",
        "userAgent": "Mozilla/5.0 (Macintosh; Intel Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Safari/605.1.15 dh-mail-native/0.1"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "publisher": "Reduce Digital Distraction Ltd",
    "shortDescription": "Mail that reads like a chat",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": ["English"]
      }
    }
  }
}
